# ===== SERVER CONFIG =====
PORT=5000
NODE_ENV=development

# ===== JWT AUTHENTICATION =====
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ===== FIREBASE FIRESTORE & AUTH =====
# Chạy local không cần service account: đặt FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 (Firestore Emulator)
# Đường dẫn file Service Account Key tải từ Firebase Console:
# Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ===== CLOUDINARY (Media Storage) =====
# Đăng ký miễn phí tại https://cloudinary.com
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret

# ===== OPENCAGE GEOCODING API =====
# Chuyển địa chỉ -> Tọa độ lat/long giao hàng (miễn phí 2500 req/ngày)
# Đăng ký tại https://opencagedata.com
API_KEY=your_opencage_api_key

# ===== GOOGLE GEMINI AI (chỉ đặt ở backend, KHÔNG nhúng vào app) =====
# Dùng cho chatbot (/api/ai/chat) và quét biên lai (/api/ai/scan-receipt)
# Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Model cho chatbot (mặc định gemini-3.5-flash-lite)
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ===== ĐĂNG NHẬP GOOGLE =====
# Project Firebase dùng để xác thực ID token Google gửi từ app (không cần service account)
FIREBASE_AUTH_PROJECT_ID=guga-27d3f

# ===== CASSO VIETQR BANK RECONCILIATION =====
# API Key lấy tại https://casso.vn để tự động đối soát chuyển khoản
CASSO_API_KEY=your_casso_api_key_here

# ===== THÔNG TIN NGÂN HÀNG VIETQR MẶC ĐỊNH =====
BANK_ID=MB
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=QUAN AN GUGUGAGA

# Secure-Token Casso gửi kèm webhook (để trống = không kiểm tra, chỉ dùng khi dev)
CASSO_SECURE_TOKEN=your_casso_webhook_secure_token
