# ===== SERVER CONFIG =====
PORT=5000
NODE_ENV=development

# ===== JWT AUTHENTICATION =====
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ===== FIREBASE FIRESTORE & AUTH =====
# Đường dẫn file Service Account Key tải từ Firebase Console:
# Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ===== CLOUDINARY (Media Storage) =====
# Đăng ký miễn phí tại https://cloudinary.com
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret

# ===== OPENCAGE GEOCODING API =====
# Chuyển địa chỉ -> Tọa độ lat/long giao hàng (miễn phí 2500 req/ngày)
# Đăng ký tại https://opencagedata.com
API_KEY=your_opencage_api_key

# ===== GOOGLE GEMINI AI =====
# Dùng cho Chatbot tư vấn món ăn và OCR quét biên lai
# Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ===== CASSO VIETQR BANK RECONCILIATION =====
# API Key lấy tại https://casso.vn để tự động đối soát chuyển khoản
CASSO_API_KEY=your_casso_api_key_here

# ===== THÔNG TIN NGÂN HÀNG VIETQR MẶC ĐỊNH =====
BANK_ID=MB
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=QUAN AN GUGUGAGA

# Secure-Token Casso gửi kèm webhook (để trống = không kiểm tra, chỉ dùng khi dev)
CASSO_SECURE_TOKEN=your_casso_webhook_secure_token

# ===== NHẬN DIỆN MÓN ĂN BẰNG ẢNH (/api/ai/recognize-food) =====
# AI Service PyTorch riêng (Flask /predict). Để trống thì dùng Gemini Vision (cần GEMINI_API_KEY).
# AI_SERVICE_URL=http://localhost:8001
# GEMINI_VISION_MODEL=gemini-2.5-flash

# ===== MOMO (ví MoMo / QR / thẻ Visa-Master) — môi trường SANDBOX, không dùng tiền thật =====
# Khoá test công khai lấy từ repo mẫu chính thức: https://github.com/momo-wallet/payment (nodejs/MoMo.js)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_sandbox_access_key
MOMO_SECRET_KEY=your_momo_sandbox_secret_key
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Địa chỉ công khai của backend cho IPN/redirect (mặc định lấy theo request qua tunnel)
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# ===== CỔNG THANH TOÁN MÔ PHỎNG (thẻ Visa/Master test + QR giả lập) — CHỈ DÙNG KHI DEMO =====
# 1 = bật: app có form nhập thẻ ngay trong ứng dụng, chỉ nhận một số thẻ test công khai (4111 1111 1111 1111...).
# Để 0 hoặc bỏ trống khi chạy thật: tắt hẳn các route thanh toán mô phỏng.
PAYMENT_SIMULATOR=0
